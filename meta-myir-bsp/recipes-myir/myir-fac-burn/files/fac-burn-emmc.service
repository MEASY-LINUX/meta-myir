[Unit]
Description=MYD-JMX95 automatic factory eMMC provisioning
After=local-fs.target

[Service]
Type=oneshot
ExecStart=@SBINDIR@/myir-burn-emmc --execute --confirm ERASE-MYD-JMX95-EMMC
TimeoutStartSec=infinity
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
