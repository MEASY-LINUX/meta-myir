From: MYIR BSP maintainers
Subject: [PATCH] Use distributed man pages without Pandoc

The release tarball ships generated man pages. Register the generation
rules only when Pandoc is available, so unpacked timestamps do not
cause make to rebuild the distributed files using an empty command.

Upstream-Status: Pending

--- a/Makefile.am
+++ b/Makefile.am
@@ -202,11 +202,13 @@ man/man3/tpm2tss_tpm2data_read.3: man/man3/tpm2tss_tpm2data_write.3
 man/man3/tpm2tss_ecc_setappdata.3: man/man3/tpm2tss_ecc_getappdata.3
 	$(AM_V_GEN)(rm $@ 2>/dev/null || true) && ln -s tpm2tss_ecc_getappdata.3 $@
 
+if HAVE_PANDOC
 man/man1/%.1: man/%.1.md
 	$(AM_V_GEN)mkdir -p man/man1 && cat $< | $(PANDOC) -s -t man >$@
 
 man/man3/%.3: man/%.3.md
 	$(AM_V_GEN)mkdir -p man/man3 && cat $< | $(PANDOC) -s -t man >$@
+endif
 
 EXTRA_DIST += \
     man/tpm2tss-genkey.1.md \
