#!/bin/sh
# SPDX-License-Identifier: MIT

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export LIBCAMERA_PIPELINES_MATCH_LIST=nxp/neo

# Fixed exposure and white balance for the validated 50 Hz indoor lighting.
exec gst-launch-1.0 -e -v libcamerasrc \
    camera-name=/base/soc/bus@42000000/i2c@42530000/camera@36 \
    ae-enable=false exposure-time=30000 analogue-gain=9.5 \
    awb-enable=false 'colour-gains=<(float)2.12, (float)1.37>' ! \
    'video/x-raw,format=YUY2,width=2112,height=1568,framerate=30/1' ! \
    queue max-size-buffers=3 max-size-bytes=0 max-size-time=0 leaky=downstream ! \
    fpsdisplaysink 'video-sink=waylandsink fullscreen=true' \
    text-overlay=false sync=false fps-update-interval=1000
